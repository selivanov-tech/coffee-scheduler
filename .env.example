# Copy to .env and fill with real values. .env is gitignored.
# All values below are FAKE examples — safe to commit.

# --- Telegram ---
BOT_TOKEN=000000:example-token
TELEGRAM_WEBHOOK_SECRET=example-webhook-secret

# --- AI provider (anthropic is the only adapter in v1) ---
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=sk-ant-example

# --- Google Sheets (service-account JSON as a single-line string) ---
GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"bot@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nFAKE\n-----END PRIVATE KEY-----\n"}
SCHEDULE_SPREADSHEET_ID=example-spreadsheet-id

# --- Admin (seeds users.json on first boot) ---
ADMIN_TELEGRAM_ID=000000000
ADMIN_NAME=Example Admin

# --- Tigris / S3-compatible ops storage (set by `fly storage create`) ---
AWS_ACCESS_KEY_ID=tid_example
AWS_SECRET_ACCESS_KEY=tsec_example
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
OPS_BUCKET=example-ops-bucket

# --- Runtime ---
NODE_ENV=development
PUBLIC_URL=https://example.fly.dev
PORT=8080
SHOP_TIMEZONE=Asia/Almaty

# --- Hard caps (see docs: Decisions / Concurrency and reliability) ---
PENDING_PROPOSAL_TTL_MINUTES=10
MAX_TOOL_ITERS=6
TOOL_TIMEOUT_MS=10000
AGENT_TURN_DEADLINE_MS=25000
WEBHOOK_TIMEOUT_MS=30000
